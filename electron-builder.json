{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.classroom.notice",
  "productName": "Teacher Helper-학급 운영",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "standalone",
      "filter": [
        "**/*",
        "!node_modules/**/*",
        "!.env"
      ]
    },
    {
      "from": ".next/standalone/node_modules",
      "to": "standalone/node_modules",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": ".next/static",
      "to": "standalone/.next/static",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "public",
      "to": "standalone/public",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "prisma",
      "to": "standalone/prisma",
      "filter": [
        "**/*",
        "!classroom-template.db",
        "!dev.db"
      ]
    },
    {
      "from": "prisma/classroom-template.db",
      "to": "db-template/classroom-template.db"
    },
    {
      "from": "build/icon.ico",
      "to": "icon.ico",
      "filter": [
        "**/*"
      ]
    }
  ],
  "publish": {
    "provider": "github",
    "owner": "scftsnow",
    "repo": "Student_Notice"
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "**/*.dll",
    "**/*.exe"
  ],
  "win": {
    "icon": "build/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Teacher Helper-학급 운영"
  }
}
